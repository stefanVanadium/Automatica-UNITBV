;!Stimulus Get
;! A1 Digital B1 Digital C1 Digital D1 Digital E1 Digital
;!Ok
;!Plot Axis_Settings
;!Xrange 0s 400ns
;!AutoUniverse
;!XminRes 1ns
;!YminRes 1n
;!Ok
.STIMULUS E1 STIM (1, 1)
+   +0s 0
.STIMULUS D1 STIM (1, 1) ;! CLOCKP 100ns 5ns 1 0
+   +0s 1
+   +5ns 0
+   Repeat Forever
+      +95ns 1
+      +5ns 0
+   EndRepeat
.STIMULUS C1 STIM (1, 1) ;! CLOCKP 100ns 95ns 0 0
+   +0s 0
+   +5ns 1
+   Repeat Forever
+      +95ns 0
+      +5ns 1
+   EndRepeat
.STIMULUS B1 STIM (1, 1)
+   +0s 1
.STIMULUS A1 STIM (1, 1)
+   +0s 1
